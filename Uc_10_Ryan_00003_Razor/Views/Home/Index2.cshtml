@{
    ViewData["Title"] = "Index2";
}

<section class="cabecalho-cafe">

    <h1>Tipos de Café</h1>

    <p>
        Cada bebida possui uma preparação e um sabor diferente.
    </p>

</section>

<section class="secao-cafe">

    <div class="grid-tipos-cafe">

        <article class="tipo-cafe">

            <img src="~/images/expresso.jpg"
                 alt="Café expresso" />

            <div>

                <h2>Expresso</h2>

                <p>
                    É preparado com água quente passando sob pressão
                    pelo café moído. Possui sabor forte e concentrado.
                </p>

            </div>

        </article>

        <article class="tipo-cafe">

            <img src="~/images/cappuccino.jpg"
                 alt="Cappuccino" />

            <div>

                <h2>Cappuccino</h2>

                <p>
                    Mistura café expresso, leite vaporizado e espuma,
                    resultando em uma bebida cremosa.
                </p>

            </div>

        </article>

        <article class="tipo-cafe">

            <img src="~/images/latte.jpg"
                 alt="Café latte" />

            <div>

                <h2>Latte</h2>

                <p>
                    Possui café expresso e bastante leite vaporizado,
                    apresentando sabor mais suave.
                </p>

            </div>

        </article>

    </div>

</section>