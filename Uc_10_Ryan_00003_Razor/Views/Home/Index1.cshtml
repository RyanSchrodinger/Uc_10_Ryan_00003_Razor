@{
    ViewData["Title"] = "Index1";
}

<section class="cabecalho-cafe">

    <h1>Nosso Cardápio</h1>

    <p>
        Conheça algumas das bebidas disponíveis em nossa cafeteria.
    </p>

</section>

<section class="secao-cafe">

    <div class="lista-cardapio">

        <article class="item-cardapio">

            <img src="~/images/expresso.jpg"
                 alt="Café expresso" />

            <div>

                <span>Café tradicional</span>

                <h2>Expresso</h2>

                <p>
                    Café concentrado, intenso e preparado
                    com grãos selecionados.
                </p>

                <strong>R$ 7,00</strong>

            </div>

        </article>

        <article class="item-cardapio">

            <img src="~/images/cappuccino.jpg"
                 alt="Cappuccino" />

            <div>

                <span>Café cremoso</span>

                <h2>Cappuccino</h2>

                <p>
                    Combinação de café, leite vaporizado
                    e uma camada cremosa de espuma.
                </p>

                <strong>R$ 12,00</strong>

            </div>

        </article>

        <article class="item-cardapio">

            <img src="~/images/latte.jpg"
                 alt="Café latte" />

            <div>

                <span>Café com leite</span>

                <h2>Latte</h2>

                <p>
                    Café suave preparado com uma quantidade
                    maior de leite vaporizado.
                </p>

                <strong>R$ 11,00</strong>

            </div>

        </article>

    </div>

    <div class="navegacao-cafe">

        <a asp-controller="Home"
           asp-action="Index2"
           class="botao-cafe">
            Conhecer os tipos de café
        </a>

    </div>

</section>