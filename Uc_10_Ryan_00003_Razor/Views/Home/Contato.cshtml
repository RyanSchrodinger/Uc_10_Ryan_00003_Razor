@{
    ViewData["Title"] = "Contato";
}

<section class="cabecalho-cafe">

    <h1>Entre em Contato</h1>

    <p>
        Consulte nossos horários e informações de atendimento.
    </p>

</section>

<section class="secao-cafe">

    <div class="grid-contato-cafe">

        <article class="card-contato-cafe">

            <span>📍</span>

            <h2>Endereço</h2>

            <p>
                Avenida do Café, 100<br />
                São Paulo - SP
            </p>

        </article>

        <article class="card-contato-cafe">

            <span>🕒</span>

            <h2>Horário</h2>

            <p>
                Segunda a sábado<br />
                Das 08:00 às 20:00
            </p>

        </article>

        <article class="card-contato-cafe">

            <span>☎️</span>

            <h2>Telefone</h2>

            <p>
                (11) 99999-9999<br />
                contato@coffeehouse.com
            </p>

        </article>

    </div>

</section>