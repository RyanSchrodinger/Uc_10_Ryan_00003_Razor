@{
    ViewData["Title"] = "Casa do Café";
}

<section class="hero">

    <div class="hero-texto">
        <h1>Coffee House</h1>

        

        <div class="cards">

            <div class="card">
                <img src="~/imagens/expresso.jpg" alt="Expresso">

                <h3>Expresso</h3>

                <p>
                    Um café intenso e encorpado para começar o dia.
                </p>
            </div>

            <div class="card">
                <img src="imagens/cappuccino.jpg" alt="Cappuccino">

                <h3>Cappuccino</h3>

                <p>
                    Leite vaporizado, espuma cremosa e muito sabor.
                </p>
            </div>

            <div class="card">
                <img src="imagens/latte.jpg" alt="Latte">

                <h3>Latte</h3>

                <p>
                    Delicado, cremoso e perfeito para qualquer momento.
                </p>
            </div>

        </div>

        <a asp-controller="Home" asp-action="Privacy">Conheça nosso cardápio</a>

    </div>

</section>



